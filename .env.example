# Réglages du serveur de production. Copier : cp .env.example .env  puis remplir.
# Guide pas à pas : docs/guides/deploiement.md
# Ne jamais commiter le fichier .env (règle 11). Les lignes commençant par # sont facultatives :
# retirer le # pour les activer. Une clé d'intégration non utilisée peut rester vide (NOM=) ;
# les autres réglages facultatifs restent commentés, car une valeur vide n'équivaut pas à une absence.
#
# Plus simple : seule la partie « Obligatoire » est nécessaire ici. Les clés marquées [écran] se collent aussi dans
# le navigateur, menu Administration › Clés API et services : chiffrées, prises en compte sans redémarrage,
# et prioritaires sur ce fichier.

# --- Obligatoire ---------------------------------------------------------------

# Domaine servi par Caddy (ex. app.votre-domaine.com), ou :80 pour un premier test par l'adresse IP.
APP_DOMAIN=
# Adresse e-mail donnée à Let's Encrypt pour le certificat HTTPS.
ACME_EMAIL=
# Mot de passe de la base : openssl rand -hex 24
POSTGRES_PASSWORD=
# Clé maître des fichiers et secrets chiffrés : openssl rand -base64 32
# À copier aussi en lieu sûr : sans elle, les fichiers des clients sont illisibles.
AKILI_MASTER_KEY=
# Adresse que le navigateur utilise, ex. https://app.votre-domaine.com
AKILI_PUBLIC_ORIGIN=
# Seulement pour un premier test par IP sans HTTPS (sans vraies données) ; à retirer ensuite.
# AKILI_ALLOW_HTTP=1
# La vraie région d'hébergement, affichée aux clients (ex. Hébergé en France).
AKILI_HOSTING_LABEL=

# Envoi des codes de connexion et des e-mails métier (ex. Gmail : smtp.gmail.com, port 465).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Gmail : « mot de passe d'application » (voir le guide de déploiement).
SMTP_PASSWORD=
# Expéditeur affiché ; par défaut SMTP_USER. Ex. Akili <no-reply@votre-domaine.com>
# MAIL_FROM=
# true : TLS dès le départ (port 465) ; false : STARTTLS (port 587). Déduit du port si absent.
# SMTP_SECURE=true

# --- Plateforme ------------------------------------------------------------------

# Nom du produit affiché (par défaut Akili). [écran]
AKILI_BRAND_NAME=Akili
# Adresses e-mail des opérateurs de la plateforme (nous), séparées par des virgules :
# elles ouvrent le menu Administration (paquets, crédits, remboursements, corrections).
AKILI_PLATFORM_ADMINS=
# Adresse de contact affichée aux organisations qui ont besoin d'aide ou de crédits. [écran]
# AKILI_SUPPORT_EMAIL=
# Crédits offerts à chaque nouvelle organisation (par défaut 10 ; 0 pour aucun). [écran]
# AKILI_SIGNUP_CREDITS=10

# --- Paiement en ligne SasPay (achat de crédits) [écran] --------------------------
# Sans clé, l'achat en ligne est refusé avec un message clair (jamais simulé).
SASPAY_API_KEY=
# Secret de signature des webhooks (tableau de bord SasPay). URL du webhook à y déclarer :
# https://app.votre-domaine.com/api/webhooks/saspay
SASPAY_WEBHOOK_SECRET=
# Par défaut, le vrai service. Pour tester sans argent réel : https://sandbox-api.saspay.me/api/v1 avec une clé sk_test_…
# Attention : c'est cette adresse qui choisit l'environnement, pas la clé (une clé sk_test_ envoyée au vrai service
# déplace de l'argent réel).
# SASPAY_BASE_URL=https://api.saspay.me/api/v1

# --- Modèles d'IA [écran : clés, noms des modèles, autre modèle, embeddings] ---------
# Aucun appel ne part tant que l'organisation n'a pas activé l'IA et donné son consentement.
# Claude (offre Entreprise) :
ANTHROPIC_API_KEY=
# AKILI_ANTHROPIC_MODEL_LIGHT=claude-haiku-5-5
# AKILI_ANTHROPIC_MODEL_HEAVY=claude-opus-5-5
# ANTHROPIC_BASE_URL=
# DeepSeek (offre Entrepreneur individuel) :
DEEPSEEK_API_KEY=
# AKILI_DEEPSEEK_MODEL_LIGHT=deepseek-flash
# AKILI_DEEPSEEK_MODEL_HEAVY=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Modèle sur notre machine ou celle du client (Ollama ou serveur compatible OpenAI) : aucune donnée ne sort.
# Une adresse hors de notre réseau (domaine public, IP publique) est traitée comme un fournisseur externe :
# consentement de l'organisation et pseudonymisation obligatoires. 0 ou 1 pour le déclarer soi-même.
# AKILI_LOCAL_MODEL_EXTERNAL=
# AKILI_LOCAL_MODEL_URL=http://ollama:11434/v1
# AKILI_LOCAL_MODEL_HEAVY=
# AKILI_LOCAL_MODEL_LIGHT=
# AKILI_LOCAL_MODEL_KEY=
# Recherche par le sens dans la base de connaissances (API /embeddings compatible OpenAI).
# Sans ce réglage, la recherche plein texte reste active.
# AKILI_EMBEDDINGS_URL=
# AKILI_EMBEDDINGS_MODEL=
# AKILI_EMBEDDINGS_KEY=
# 0 si le service d'embeddings tourne chez nous (pas de consentement « fournisseur externe » requis).
# AKILI_EMBEDDINGS_EXTERNAL=1
# Durée du cache des réponses, en heures (0 : pas de cache).
# AKILI_AI_CACHE_HOURS=24
# Jours de conservation des extraits de questions et réponses dans le journal de l'IA.
# AKILI_AI_LOG_RETENTION_DAYS=90

# --- Connecteurs [écran : Google et WhatsApp] ---------------------------------------
# Google (Gmail, Sheets) : client OAuth « Application Web ». URI de redirection à déclarer :
# https://app.votre-domaine.com/api/connectors/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# WhatsApp Business Platform (API Cloud de Meta). URL de rappel du webhook à déclarer :
# https://app.votre-domaine.com/api/webhooks/whatsapp
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_VERSION=v23.0
# Serveurs MCP sur un réseau privé : seulement pour une installation chez le client (protection SSRF).
# AKILI_MCP_ALLOW_PRIVATE=1

# --- Documents --------------------------------------------------------------------
# Lecture des scans et photos (OCR) sur ce serveur : off pour la désactiver.
# AKILI_OCR=on
# AKILI_OCR_MAX_PAGES=10
# Antivirus ClamAV (clamd) qui analyse chaque fichier déposé.
# CLAMAV_HOST=
# CLAMAV_PORT=3310
